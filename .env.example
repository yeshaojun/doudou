DEEPSEEK_API_KEY=replace_on_server_only
DEEPSEEK_MODEL=deepseek-flash
TUZI_API_KEY=replace_on_server_only
TUZI_ASR_MODEL=whisper-1
TUZI_TTS_MODEL=tts-1-hd
TUZI_VOICE=nova
# Enable only after a successful probe of the actual account and endpoint.
TUZI_ASR_ENABLED=false
TUZI_TTS_ENABLED=false
# Local interactive development; switch to aliyun with a general key later.
VOICE_PROVIDER=token-plan
ALI_TOKEN_PLAN_API_KEY=replace_on_server_only
ALI_API_KEY=replace_with_general_key_when_using_aliyun
ALI_ASR_MODEL=qwen-audio-3.0-asr-flash
ALI_TTS_MODEL=qwen-audio-3.0-tts-plus
ALI_VOICE=longanhuan_v3.6
ACCESS_PASSWORD=choose_a_private_access_password
APP_SESSION_SECRET=generate_a_long_random_session_secret
